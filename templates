<!DOCTYPE html>
<html lang="or">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>SONA PERSONAL AI</title>
  <link rel="manifest" href="/static/manifest.json" />
  <meta name="theme-color" content="#030712" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body {
      background: radial-gradient(circle at 50% 45%, #1e1b4b 0%, #060b19 60%, #02040a 100%);
      color: #e0f2fe; min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; overflow-x: hidden;
    }
    .header {
      display: flex; justify-content: space-between; align-items: center; padding: 14px 18px;
      border-bottom: 1px solid rgba(34, 211, 238, 0.25); background: rgba(6, 11, 25, 0.8); backdrop-filter: blur(10px);
    }
    .badge { font-size: 11px; color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); padding: 4px 10px; border-radius: 20px; }
    .title-box { text-align: center; }
    .title-box h1 { font-size: 24px; letter-spacing: 5px; color: #67e8f9; text-shadow: 0 0 15px #06b6d4, 0 0 30px #a855f7; }
    .title-box p { font-size: 10px; letter-spacing: 3px; color: #c084fc; }
    .main-grid {
      display: grid; grid-template-columns: 1fr; gap: 16px; padding: 14px; max-width: 1200px; width: 100%; margin: auto; align-items: center;
    }
    @media(min-width: 850px) { .main-grid { grid-template-columns: 270px 1fr 270px; } }
    .panel {
      background: rgba(10, 18, 36, 0.75); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 16px;
      padding: 14px; box-shadow: 0 0 20px rgba(6, 182, 212, 0.15); backdrop-filter: blur(12px);
    }
    .panel h3 { font-size: 13px; color: #22d3ee; margin-bottom: 10px; border-bottom: 1px solid rgba(34, 211, 238, 0.2); padding-bottom: 6px; }
    .cmd-btn {
      width: 100%; text-align: left; background: rgba(15, 23, 42, 0.8); color: #bae6fd; border: 1px solid rgba(56, 189, 248, 0.25);
      padding: 10px 12px; border-radius: 10px; margin-bottom: 8px; cursor: pointer; font-size: 13px; transition: 0.2s;
    }
    .cmd-btn:hover { border-color: #22d3ee; background: rgba(34, 211, 238, 0.15); box-shadow: 0 0 12px rgba(34, 211, 238, 0.3); }
    .holo-stage { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px; }
    .ring-outer {
      width: 280px; height: 280px; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center;
      border: 2px dashed rgba(34, 211, 238, 0.6); box-shadow: 0 0 45px rgba(168, 85, 247, 0.45), inset 0 0 35px rgba(34, 211, 238, 0.35);
      animation: spin 18s linear infinite;
    }
    .ring-inner {
      width: 240px; height: 240px; border-radius: 50%; border: 3px solid rgba(192, 132, 252, 0.7);
      position: absolute; animation: spinRev 12s linear infinite;
    }
    @keyframes spin { 100% { transform: rotate(360deg); } }
    @keyframes spinRev { 100% { transform: rotate(-360deg); } }
    .avatar-core {
      position: absolute; width: 215px; height: 215px; border-radius: 50%; overflow: hidden;
      background: radial-gradient(circle, #3b0764 0%, #090d16 80%); display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 30px #a855f7;
    }
    .sona-label {
      position: absolute; font-size: 28px; font-weight: 900; letter-spacing: 6px; color: #ffffff;
      text-shadow: 0 0 12px #22d3ee, 0 0 25px #c084fc; z-index: 5; pointer-events: none;
    }
    .wave-bars { display: flex; gap: 4px; height: 34px; align-items: center; margin-top: 14px; }
    .bar { width: 4px; height: 10px; background: linear-gradient(to top, #22d3ee, #c084fc); border-radius: 4px; transition: height 0.15s; }
    .speaking .bar { animation: pulseWave 0.45s infinite alternate; }
    .bar:nth-child(2n) { animation-delay: 0.15s; }
    .bar:nth-child(3n) { animation-delay: 0.3s; }
    @keyframes pulseWave { 0% { height: 8px; } 100% { height: 32px; } }
    .chat-box {
      width: 100%; max-width: 520px; margin-top: 14px; background: rgba(8, 15, 30, 0.85);
      border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 14px; padding: 12px;
    }
    .reply-text { min-height: 48px; font-size: 14px; color: #f0f9ff; line-height: 1.5; margin-bottom: 10px; }
    .input-row { display: flex; gap: 8px; }
    input {
      flex: 1; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(34, 211, 238, 0.4);
      color: #fff; padding: 10px 12px; border-radius: 10px; outline: none; font-size: 14px;
    }
    .mic-btn, .send-btn {
      background: linear-gradient(135deg, #06b6d4, #9333ea); border: none; color: #fff;
      padding: 10px 14px; border-radius: 10px; cursor: pointer; font-weight: bold;
    }
    .mic-btn.active { background: #ef4444; box-shadow: 0 0 15px #ef4444; }
    .dock {
      display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; padding: 12px;
      border-top: 1px solid rgba(34, 211, 238, 0.25); background: rgba(4, 8, 18, 0.9);
    }
    .dock-item {
      font-size: 11px; color: #67e8f9; border: 1px solid rgba(34, 211, 238, 0.35);
      padding: 8px 12px; border-radius: 20px; background: rgba(15, 23, 42, 0.7); cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="badge">ARM 7.5 MThz • ONLINE</div>
    <div class="title-box">
      <h1>SONA</h1>
      <p>PERSONAL AI</p>
    </div>
    <div class="badge" id="statusBadge">⚡ SONA READY</div>
  </div>

  <div class="main-grid">
    <div class="panel">
      <h3>&lt;&gt; Sona Command Center</h3>
      <button class="cmd-btn" onclick="quickAsk('Juhar Sona, kemiti acha?')">💬 ଗାଉଁଲି ଓଡ଼ିଆ କଥାବାର୍ତ୍ତା</button>
      <button class="cmd-btn" onclick="quickAsk('Are Sona, ka hal ba?')">🗣️ देसी हिंदी बातचीत</button>
      <button class="cmd-btn" onclick="window.open('https://youtube.com','_blank')">▶️ YouTube Open କର</button>
      <button class="cmd-btn" onclick="window.open('https://wa.me/','_blank')">📱 WhatsApp ଖୋଲ</button>
      <button class="cmd-btn" onclick="window.location.href='tel:'">📞 Call Dialer ଖୋଲ</button>
    </div>

    <div class="holo-stage" id="holoStage">
      <div class="ring-outer">
        <div class="ring-inner"></div>
      </div>
      <div class="avatar-core">
        <svg viewBox="0 0 200 220" width="200" height="220">
          <defs>
            <linearGradient id="neonGirl" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#22d3ee" />
              <stop offset="50%" stop-color="#c084fc" />
              <stop offset="100%" stop-color="#f472b6" />
            </linearGradient>
          </defs>
          <path d="M65,65 Q100,15 135,65 Q155,115 148,180 L132,180 Q135,120 125,85 Q100,105 75,85 Q65,120 68,180 L52,180 Q45,115 65,65 Z" fill="none" stroke="url(#neonGirl)" stroke-width="2.5"/>
          <ellipse cx="100" cy="68" rx="22" ry="28" fill="rgba(168,85,247,0.2)" stroke="#67e8f9" stroke-width="2.5"/>
          <path d="M72,112 Q100,98 128,112 L138,195 L62,195 Z" fill="rgba(34,211,238,0.12)" stroke="url(#neonGirl)" stroke-width="2.5"/>
          <path d="M82,125 L100,145 L118,125 M85,155 L100,170 L115,155" fill="none" stroke="#38bdf8" stroke-width="1.8"/>
        </svg>
        <div class="sona-label">SONA</div>
      </div>

      <div class="wave-bars" id="waveBars">
        <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
        <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
        <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
      </div>

      <div class="chat-box">
        <div class="reply-text" id="replyBox">ଜୁହାର ଭାଇ! ମୁଁ SONA କହୁଛି। ମାଇକ୍ ଦବାଇ ଓଡ଼ିଆ କିମ୍ବା ହିନ୍ଦୀରେ କୁହ, କ’ଣ ସାହାଯ୍ୟ କରିବି?</div>
        <div class="input-row">
          <button class="mic-btn" id="micBtn" onclick="startVoice()">🎤</button>
          <input type="text" id="userInput" placeholder="ଓଡ଼ିଆ ବା ହିନ୍ଦୀରେ ଲେଖ..." onkeydown="if(event.key==='Enter') sendMessage()" />
          <button class="send-btn" onclick="sendMessage()">➤</button>
        </div>
      </div>
    </div>

    <div class="panel">
      <h3>⚡ Voice & System Status</h3>
      <button class="cmd-btn" onclick="startVoice()">🎙️ Sona Voice Assistant</button>
      <button class="cmd-btn" onclick="quickAsk('Mote eka sundar Odia shayari suna')">✨ ଗାଉଁଲି ଶାୟରୀ ଶୁଣାଅ</button>
      <button class="cmd-btn" onclick="quickAsk('Aji ra mausam au dina kemiti rahiba?')">🌤️ ଆଜିର ଦିନ ବିଷୟରେ କୁହ</button>
      <button class="cmd-btn" onclick="window.speechSynthesis.cancel()">🔇 Voice ବନ୍ଦ କର</button>
    </div>
  </div>

  <div class="dock">
    <div class="dock-item" onclick="startVoice()">🎙️ AI VOICE</div>
    <div class="dock-item" onclick="quickAsk('System check kara Sona')">🛡️ SECURITY OK</div>
    <div class="dock-item" onclick="quickAsk('Battery health kemiti achi?')">🔋 BATTERY 100%</div>
    <div class="dock-item" onclick="quickAsk('Smart automation chalu kara')">⚙️ AUTOMATIONS</div>
  </div>

  <script>
    function speak(text) {
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(text);
      const voices = window.speechSynthesis.getVoices();
      const femaleVoice = voices.find(v => (v.lang.includes('hi') || v.lang.includes('or') || v.lang.includes('IN')) && (v.name.includes('Female') || v.name.includes('Swara') || v.name.includes('Google'))) || voices.find(v => v.lang.includes('IN'));
      if (femaleVoice) utter.voice = femaleVoice;
      utter.pitch = 1.15;
      utter.rate = 0.98;
      utter.onstart = () => {
        document.getElementById('waveBars').classList.add('speaking');
        document.getElementById('statusBadge').innerText = '🔊 SPEAKING...';
      };
      utter.onend = () => {
        document.getElementById('waveBars').classList.remove('speaking');
        document.getElementById('statusBadge').innerText = '⚡ SONA READY';
      };
      window.speechSynthesis.speak(utter);
    }

    function quickAsk(msg) {
      document.getElementById('userInput').value = msg;
      sendMessage();
    }

    async function sendMessage() {
      const input = document.getElementById('userInput');
      const msg = input.value.trim();
      if (!msg) return;
      input.value = '';
      document.getElementById('replyBox').innerText = '⏳ SONA ଭାବୁଛି...';
      document.getElementById('statusBadge').innerText = '🧠 THINKING...';
      try {
        const res = await fetch('/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg })
        });
        const data = await res.json();
        document.getElementById('replyBox').innerText = data.reply;
        speak(data.reply);
      } catch (e) {
        document.getElementById('replyBox').innerText = 'Network error bhai, puni try kara.';
      }
    }

    function startVoice() {
      const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRec) { alert('Ei browser re voice support nahi, Chrome use kara bhai.'); return; }
      const rec = new SpeechRec();
      rec.lang = 'hi-IN';
      const micBtn = document.getElementById('micBtn');
      micBtn.classList.add('active');
      document.getElementById('statusBadge').innerText = '🎤 LISTENING...';
      rec.onresult = (e) => {
        const text = e.results[0][0].transcript;
        document.getElementById('userInput').value = text;
        sendMessage();
      };
      rec.onend = () => micBtn.classList.remove('active');
      rec.start();
    }
  </script>
</body>
</html>
